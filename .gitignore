# Publication allowlist: raw downloads, caches, exports and local screenshots
# are intentionally excluded, even from `git add .`.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/THIRD_PARTY_NOTICES.txt
!/requirements.txt
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/pages.yml
!/app/
/app/*
!/app/*.html
!/app/*.css
!/app/*.mjs
!/app/package.json
!/app/package-lock.json
!/app/start.cmd
!/app/data/
/app/data/*
!/app/data/experts.json
!/app/data/player-directory.json
!/app/data/player-catalog.json
!/app/data/guess-players.json
!/app/data/guess-extra-metrics.json
!/app/data/guess-source-cba.json
!/app/tests/
/app/tests/*
!/app/tests/*.mjs
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.mjs
!/config/
/config/*
!/config/*.json
!/config/*.yaml
!/supabase/
/supabase/*
!/supabase/migrations/
/supabase/migrations/*
!/supabase/migrations/*.sql
/config/guess-cba-identity-candidates.json
/config/guess-cba-identity-audit-*.json
!/docs/
/docs/*
!/docs/*.md
!/licenses/
/licenses/*
!/licenses/*.txt
!/data/
/data/*
!/data/processed/
/data/processed/*
!/data/processed/goat_model_v0_2_web.json

# Never override these exclusions with directory wildcards above.
**/.env
**/.env.*
**/*.pem
**/*.key
**/node_modules/
**/__pycache__/
**/.DS_Store
**/Thumbs.db
